POSTGRES_PASSWORD=health_agent
METABASE_URL=http://127.0.0.1:53000
METABASE_ADMIN_EMAIL=health-agent@localhost
# Management panel: fixed IPv4 loopback binding only; public addresses are rejected.
PANEL_HOST=127.0.0.1
PANEL_PORT=8766
WHOOP_CLIENT_CREDENTIALS_FILE=.tokens/whoop-client.json
# WHOOP_CLIENT_ID=optional-env-override
# WHOOP_CLIENT_SECRET=optional-env-override
WHOOP_REDIRECT_URI=http://127.0.0.1:8765/whoop/callback
WHOOP_TOKEN_ROOT=.tokens/whoop
GMAIL_ROOT=data/google/gmail
GOOGLE_OAUTH_CLIENT_SECRETS=data/secrets/google-oauth-client.json
GOOGLE_OAUTH_PUBLISHING_STATUS=testing
GMAIL_MAX_ATTACHMENT_BYTES=26214400
GMAIL_HTTP_TIMEOUT_SECONDS=30
GOOGLE_DRIVE_ROOT=data/google-drive
GOOGLE_DRIVE_CLIENT_SECRETS=data/secrets/google-drive-oauth-client.json
GOOGLE_DRIVE_HTTP_TIMEOUT_SECONDS=30
GOOGLE_SHEETS_ROOT=data/google-sheets
# The same Desktop OAuth client JSON may be used; Sheets still receives its own exact-scope token.
GOOGLE_SHEETS_CLIENT_SECRETS=data/secrets/google-oauth-client.json
GOOGLE_SHEETS_HTTP_TIMEOUT_SECONDS=30
TELEGRAM_ROOT=data/telegram
# Optional override; the bot token itself is configured interactively and never here.
# TELEGRAM_BOT_TOKEN_FILE=data/telegram/bot-token
# TELEGRAM_STATE_FILE=data/telegram/state.sqlite3
# TELEGRAM_STAGING_ROOT=data/telegram/staging
AUTOMATION_ROOT=data/automation
# Optional Yandex question-answering overrides. When omitted, questions reuse
# YANDEX_MODEL, OPENAI_MAX_OUTPUT_TOKENS, no reasoning and a 30-second timeout.
# Lab extraction is unaffected by these QA-only overrides.
# YANDEX_QUESTION_MODEL=question-model-id
YANDEX_QUESTION_TIMEOUT_SECONDS=30
YANDEX_QUESTION_REASONING_EFFORT=none
# Optional 64..8000; omit to keep the shared output budget (default 2000).
# YANDEX_QUESTION_MAX_OUTPUT_TOKENS=4000
# The confirmed-reminder LaunchAgent reuses this private root for its own plist,
# lock, and bounded logs; its interval is intentionally fixed at 60 seconds.
