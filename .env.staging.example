# Synthetic local-only defaults. Copy to .env.staging only when overrides are needed.
STAGING_COMPOSE_PROJECT=health-agent-staging
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=56432
POSTGRES_DB=health_agent_staging
POSTGRES_USER=health_agent_staging
POSTGRES_PASSWORD=health_agent_staging_1
STAGING_METABASE_PORT=54000
METABASE_URL=http://127.0.0.1:54000
METABASE_ADMIN_EMAIL=health-agent-staging@localhost.local
VAULT_ROOT=.staging/vault
TEMPORARY_ROOT=.staging/tmp
WHOOP_TOKEN_ROOT=.staging/tokens/whoop
CONNECTOR_STATE_ROOT=.staging/connector-state
GMAIL_ROOT=.staging/connector-state/gmail
GOOGLE_OAUTH_CLIENT_SECRETS=.staging/credentials/google-oauth-client.json
GOOGLE_OAUTH_PUBLISHING_STATUS=testing
GOOGLE_DRIVE_ROOT=.staging/connector-state/drive
GOOGLE_DRIVE_CLIENT_SECRETS=.staging/credentials/google-drive-client.json
GOOGLE_SHEETS_ROOT=.staging/connector-state/sheets
GOOGLE_SHEETS_CLIENT_SECRETS=.staging/credentials/google-sheets-client.json
GOOGLE_CALENDAR_ROOT=.staging/connector-state/calendar
GOOGLE_CALENDAR_CLIENT_SECRETS=.staging/credentials/google-calendar-client.json
AUTOMATION_ROOT=.staging/automation
OPENAI_API_KEY_FILE=.staging/credentials/openai-api-key
YANDEX_API_KEY_FILE=.staging/credentials/yandex-api-key
TELEGRAM_ROOT=.staging/connector-state/telegram
TELEGRAM_BOT_TOKEN_FILE=.staging/credentials/telegram-bot-token.txt
TELEGRAM_STATE_FILE=.staging/connector-state/telegram/state.sqlite3
TELEGRAM_STAGING_ROOT=.staging/tmp/telegram
WHOOP_CLIENT_CREDENTIALS_FILE=.staging/credentials/whoop-client.json
WHOOP_REDIRECT_URI=http://127.0.0.1:8765/whoop/callback
