+def _run_telegram_launchd(action: str, env_file: Path) -> None:
+    try:
+        manager = _telegram_launchd_manager(env_file)
+        if action == "render":
+            manager.render()
+            status = "rendered"
+        elif action == "install":
+            status = manager.install()
+        elif action == "status":
+            status = manager.status()
+        elif action == "stop":
+            status = manager.stop()
+        elif action == "remove":
+            status = manager.remove()
+        else:
